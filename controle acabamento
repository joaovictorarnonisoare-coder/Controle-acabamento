        <h2 class="text-xl font-bold text-slate-800 mb-4 border-b pb-2">Controle Detalhado por Pavimento</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-6" id="torres-grid">
            <!-- Gerado pelo Javascript -->
        </div>

    </div>

