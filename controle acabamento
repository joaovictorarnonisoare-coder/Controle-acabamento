            <div class="glass-card !h-auto p-5 border-l-4 border-l-orange-500">
                <p class="text-slate-500 font-semibold text-xs uppercase mb-1">Serviço Mais Adiantado</p>
                <h3 class="text-xl font-bold text-slate-800 mt-1" id="kpi-service">-</h3>
            </div>
        </div>

        <!-- Gráficos -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-8">
            <div class="glass-card !h-auto p-5 lg:col-span-2">
                <h2 class="text-sm font-bold text-slate-800 mb-3 uppercase tracking-wide">Progresso Geral por Torre</h2>
                <div class="relative h-48"><canvas id="barChart"></canvas></div>
            </div>
            <div class="glass-card !h-auto p-5">
