<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Painel Interativo de Andares | Obras</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        body { background-color: #f8fafc; font-family: 'Segoe UI', system-ui, sans-serif; }
        
        .glass-card {
            background: #ffffff;
            border-radius: 1rem;
            box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05), 0 2px 4px -1px rgba(0, 0, 0, 0.03);
            border: 1px solid rgba(226, 232, 240, 0.8);
            display: flex;
            flex-direction: column;
            height: 420px;
        }

        .tower-graphic {
            position: relative;
            width: 60px;
            height: 120px;
            border: 3px solid #cbd5e1;
            border-radius: 6px 6px 0 0;
            background: #f1f5f9;
            overflow: hidden;
            margin: 0 auto;
        }
        
        .tower-fill {
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            transition: height 0.6s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.6s ease;
        }
        
        .tower-windows {
            position: absolute;
            top: 4px; left: 4px; right: 4px; bottom: 4px;
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 4px;
            align-content: start;
            z-index: 10;
        }
        
        .window {
            width: 100%;
            height: 10px;
            background: rgba(255,255,255,0.85);
            border-radius: 1px;
            box-shadow: inset 0 1px 2px rgba(0,0,0,0.1);
        }

        .status-btn {
            width: 100%;
            height: 26px;
            border-radius: 4px;
            border: 1px solid rgba(0,0,0,0.1);
            cursor: pointer;
            transition: transform 0.1s, filter 0.2s;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            font-size: 11px;
        }
        .status-btn:active { transform: scale(0.95); }
        .status-btn:hover { filter: brightness(0.9); }

        .table-header { font-size: 10px; font-weight: 700; color: #64748b; text-transform: uppercase; padding-bottom: 4px; border-bottom: 1px solid #e2e8f0; text-align: center; }
        .table-cell { padding: 4px 2px; text-align: center; }
        .bloco-title { font-size: 11px; font-weight: bold; background: #f1f5f9; padding: 4px 8px; border-radius: 4px; margin-top: 8px; margin-bottom: 4px; color: #334155; }
        
        .custom-scroll {
            overflow-y: auto;
            padding-right: 4px;
            flex-grow: 1;
        }
        .custom-scroll::-webkit-scrollbar { width: 6px; }
        .custom-scroll::-webkit-scrollbar-track { background: #f1f5f9; border-radius: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb { background: #cbd5e1; border-radius: 4px; }
        .custom-scroll::-webkit-scrollbar-thumb:hover { background: #94a3b8; }

        .modal-overlay {
            position: fixed; top: 0; left: 0; right: 0; bottom: 0;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(2px);
            z-index: 100;
            display: none;
            align-items: center;
            justify-content: center;
        }
        .modal-content {
            background: white;
            border-radius: 12px;
            width: 90%;
            max-width: 400px;
            box-shadow: 0 20px 25px -5px rgba(0,0,0,0.1);
            animation: modalPop 0.2s ease-out;
        }
        @keyframes modalPop {
            0% { transform: scale(0.95); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }
    </style>
</head>
<body class="text-slate-800 pb-12">

    <!-- Modal de Edição -->
    <div id="editModal" class="modal-overlay">
        <div class="modal-content overflow-hidden">
            <div class="bg-blue-600 px-5 py-4 text-white flex justify-between items-center">
                <h3 class="font-bold text-lg"><i class="fa-solid fa-pen-to-square mr-2"></i>Editar Serviço</h3>
                <button onclick="closeModal()" class="text-white/70 hover:text-white"><i class="fa-solid fa-xmark text-xl"></i></button>
            </div>
            <div class="p-5 space-y-4">
                <div class="bg-slate-50 p-3 rounded-lg border border-slate-100 mb-2">
                    <p class="text-xs text-slate-500 font-semibold uppercase mb-1">Localização</p>
                    <p class="text-sm font-bold text-slate-800" id="modal-location">Torre 1 - Bloco 1 - Térreo</p>
                    <p class="text-blue-600 font-bold mt-1" id="modal-service">Pintura 1ª</p>
                </div>

                <div>
                    <label class="block text-xs font-bold text-slate-600 mb-1">Status</label>
                    <select id="modal-status" class="w-full border border-slate-300 rounded-md p-2 text-sm focus:border-blue-500 focus:ring-1 focus:ring-blue-500 outline-none">
                        <option value="NÃO INICIADO">Não Iniciado</option>
                        <option value="EXECUTANDO">Executando</option>
                        <option value="FEITO">Pronto</option>
                    </select>
                </div>

                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">Data Início</label>
                        <input type="date" id="modal-ini" class="w-full border border-slate-300 rounded-md p-2 text-sm focus:border-blue-500 outline-none">
                    </div>
                    <div>
                        <label class="block text-xs font-bold text-slate-600 mb-1">Data Fim</label>
                        <input type="date" id="modal-fim" class="w-full border border-slate-300 rounded-md p-2 text-sm focus:border-blue-500 outline-none">
                    </div>
                </div>
            </div>
            <div class="bg-slate-50 px-5 py-3 border-t border-slate-200 flex justify-end gap-3">
                <button onclick="closeModal()" class="px-4 py-2 text-sm font-medium text-slate-600 hover:bg-slate-200 rounded-md transition">Cancelar</button>
                <button onclick="saveModal()" class="px-4 py-2 text-sm font-medium bg-blue-600 hover:bg-blue-700 text-white rounded-md transition shadow-sm">Salvar Alterações</button>
            </div>
        </div>
    </div>

    <!-- Menu Superior -->
    <nav class="bg-white border-b border-slate-200 shadow-sm sticky top-0 z-40">
