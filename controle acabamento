                b.pavimentos.forEach(p => {
                    sum += getStatusValue(p.p1);
                    sum += getStatusValue(p.lam);
                    sum += getStatusValue(p.p2);
                    sum += getStatusValue(p.limp);
                    count += 4;
                });
            });
            
            const totalPct = count === 0 ? 0 : (sum / count) * 100;
            torre.totalCalculado = totalPct;
            
            const totalEl = document.getElementById(`total-t${tIdx}`);
            const fillEl = document.getElementById(`fill-t${tIdx}`);
            const color = getColorHex(totalPct);
            
            if(totalEl && fillEl) {
                totalEl.innerText = totalPct.toFixed(1) + '%';
                totalEl.style.color = color;
                fillEl.style.height = totalPct + '%';
                fillEl.style.backgroundColor = color;
            }
        }

        function renderTorres() {
            const grid = document.getElementById('torres-grid');
            grid.innerHTML = '';
            
            obrasData.forEach((torre, tIdx) => {
                recalcTower(tIdx);
                const totalPct = torre.totalCalculado;
                const color = getColorHex(totalPct);
                
                let windowsHtml = '';
                for(let i=0; i<10; i++) windowsHtml += '<div class="window"></div>';
                
                let blocosHtml = '';
                torre.blocos.forEach((bloco, bIdx) => {
                    blocosHtml += `<div class="bloco-title">${bloco.name}</div>`;
                    blocosHtml += `
                        <table class="w-full mb-1">
                            <tr>
                                <td class="table-header w-1/5 text-left pl-1">Pav</td>
                                <td class="table-header w-1/5">P1ª</td>
                                <td class="table-header w-1/5">Lam.</td>
                                <td class="table-header w-1/5">P2ª</td>
                                <td class="table-header w-1/5">Limp.</td>
                            </tr>
                    `;
                    
                    bloco.pavimentos.forEach((pav, pIdx) => {
                        const renderBtn = (sKey, status) => {
                            let icon = getStatusIcon(status);
                            if(status === 'NÃO INICIADO' && (pav[sKey+'_ini'] || pav[sKey+'_fim'])) {
                                icon = '<i class="fa-regular fa-calendar-dots text-slate-400"></i>';
                            }
                            return `<button id="btn-${tIdx}-${bIdx}-${pIdx}-${sKey}" class="status-btn shadow-sm" style="background-color: ${getStatusColor(status)}" onclick="openModal(${tIdx}, ${bIdx}, ${pIdx}, '${sKey}')" title="Clique para editar Status e Datas">${icon}</button>`;
                        };

                        blocosHtml += `
                            <tr>
                                <td class="text-xs font-semibold text-slate-600 pl-1 text-left whitespace-nowrap">${pav.pav}</td>
                                <td class="table-cell">${renderBtn('p1', pav.p1)}</td>
                                <td class="table-cell">${renderBtn('lam', pav.lam)}</td>
                                <td class="table-cell">${renderBtn('p2', pav.p2)}</td>
                                <td class="table-cell">${renderBtn('limp', pav.limp)}</td>
                            </tr>
                        `;
                    });
                    blocosHtml += `</table>`;
                });
                
                const card = document.createElement('div');
                card.className = `glass-card p-4`;
                card.innerHTML = `
                    <div class="text-center font-bold text-base text-slate-700 mb-3 border-b pb-2 uppercase tracking-wider">${torre.name}</div>
                    <div class="flex gap-3 h-full pb-4">
                        <div class="flex flex-col items-center w-1/4 pt-2">
                            <div class="tower-graphic shadow-sm">
                                <div id="fill-t${tIdx}" class="tower-fill" style="height: ${totalPct}%; background-color: ${color}"></div>
                                <div class="tower-windows">${windowsHtml}</div>
                            </div>
                            <div id="total-t${tIdx}" class="text-xl font-black mt-2 transition-colors duration-300" style="color: ${color}">
                                ${totalPct.toFixed(1)}%
                            </div>
                        </div>
                        <div class="w-3/4 custom-scroll">
                            ${blocosHtml}
                        </div>
                    </div>
                `;
                grid.appendChild(card);
            });
        }

        function saveData() { localStorage.setItem('controleObraPavimentosV3', JSON.stringify(obrasData)); }

        window.resetData = function() {
            if(confirm("Tem certeza que deseja zerar? Os dados voltarão para os valores iniciais da sua planilha Excel.")) {
                obrasData = JSON.parse(JSON.stringify(defaultData));
                saveData();
                renderTorres();
                updateGlobalUI();
            }
        }

        function updateGlobalUI() {
            let sumTotal = 0, sumP1 = 0, sumLam = 0, sumP2 = 0, sumLimp = 0, countTotal = 0;
            let bestTorre = obrasData[0];

            obrasData.forEach(torre => {
                if (torre.totalCalculado > bestTorre.totalCalculado) bestTorre = torre;
                torre.blocos.forEach(b => {
                    b.pavimentos.forEach(p => {
                        sumP1 += getStatusValue(p.p1);
                        sumLam += getStatusValue(p.lam);
                        sumP2 += getStatusValue(p.p2);
                        sumLimp += getStatusValue(p.limp);
                        countTotal++;
                    });
                });
                sumTotal += torre.totalCalculado;
            });

            const avgTotal = obrasData.length > 0 ? sumTotal / obrasData.length : 0;
            const p1Pct = countTotal > 0 ? (sumP1 / countTotal) * 100 : 0;
            const lamPct = countTotal > 0 ? (sumLam / countTotal) * 100 : 0;
            const p2Pct = countTotal > 0 ? (sumP2 / countTotal) * 100 : 0;
            const limpPct = countTotal > 0 ? (sumLimp / countTotal) * 100 : 0;

            const services = [
                {name: 'Pintura 1ª', val: p1Pct}, {name: 'Laminado', val: lamPct},
                {name: 'Pintura 2ª', val: p2Pct}, {name: 'Limpeza', val: limpPct}
            ];
            const bestService = services.reduce((prev, current) => (prev.val > current.val) ? prev : current);

            document.getElementById('kpi-overall').innerText = avgTotal.toFixed(1) + '%';
            document.getElementById('kpi-best').innerHTML = `${bestTorre.name} <span class="text-sm text-slate-400 font-normal ml-1">(${bestTorre.totalCalculado.toFixed(0)}%)</span>`;
            document.getElementById('kpi-service').innerHTML = `${bestService.name} <span class="text-sm text-slate-400 font-normal ml-1">(${bestService.val.toFixed(0)}%)</span>`;

            if(barChart && radarChart) {
                barChart.data.datasets[0].data = obrasData.map(d => d.totalCalculado);
                barChart.data.datasets[0].backgroundColor = obrasData.map(d => getColorHex(d.totalCalculado));
                barChart.update();

                radarChart.data.datasets[0].data = [p1Pct, lamPct, p2Pct, limpPct];
                radarChart.update();
            }
        }

        function initCharts() {
            const ctxBar = document.getElementById('barChart').getContext('2d');
            barChart = new Chart(ctxBar, {
                type: 'bar',
                data: {
                    labels: obrasData.map(d => d.name),
                    datasets: [{
                        data: obrasData.map(d => d.totalCalculado || 0),
                        backgroundColor: obrasData.map(d => getColorHex(d.totalCalculado || 0)),
                        borderRadius: 4,
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, plugins: { legend: { display: false } }, scales: { y: { max: 100, grid: { color: '#f1f5f9' }, ticks:{font:{size:10}} }, x: { grid: { display: false }, ticks:{font:{size:10}} } } }
            });

            const ctxRadar = document.getElementById('radarChart').getContext('2d');
            radarChart = new Chart(ctxRadar, {
                type: 'polarArea',
                data: {
                    labels: ['P1ª', 'Lam', 'P2ª', 'Limp'],
                    datasets: [{
                        data: [0,0,0,0],
                        backgroundColor: ['rgba(59,130,246,0.7)', 'rgba(16,185,129,0.7)', 'rgba(245,158,11,0.7)', 'rgba(139,92,246,0.7)'],
                        borderWidth: 0
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false, scales: { r: { ticks: { display: false } } }, plugins: { legend: { position: 'right', labels:{font:{size:10}} } } }
            });
        }
    </script>
</body>
</html>
