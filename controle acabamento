                    <span class="bg-emerald-100 text-emerald-800 text-xs font-bold px-3 py-1 rounded-full uppercase flex items-center">
                        <i class="fa-solid fa-check mr-1"></i> Salvo
                    </span>
                </div>
            </div>
        </div>
    </nav>

    <div class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-6">
        
        <!-- Cabeçalho e Legenda -->
        <div class="mb-6 flex justify-between items-end">
            <div>
                <h1 class="text-2xl font-extrabold text-slate-800">Mapeamento de Pavimentos e Datas</h1>
                <p class="text-slate-500 mt-1 text-sm">Clique nos quadradinhos para editar Status e inserir Datas de Início/Fim:<br><br>
                <span class="inline-block w-4 h-4 bg-slate-200 border border-slate-300 rounded-sm mr-1 align-middle"></span> <span class="align-middle">Não Iniciado</span> &nbsp;&nbsp;|&nbsp;&nbsp; 
                <span class="inline-block w-4 h-4 bg-yellow-400 border border-yellow-500 rounded-sm mr-1 align-middle"></span> <span class="align-middle">Executando</span> &nbsp;&nbsp;|&nbsp;&nbsp; 
                <span class="inline-block w-4 h-4 bg-emerald-500 border border-emerald-600 rounded-sm mr-1 align-middle"></span> <span class="align-middle">Pronto</span>
                </p>
            </div>
        </div>

        <!-- KPIs Globais -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mb-8">
            <div class="glass-card !h-auto p-5 border-l-4 border-l-blue-500">
                <p class="text-slate-500 font-semibold text-xs uppercase mb-1">Avanço Global da Obra</p>
                <h3 class="text-3xl font-bold text-slate-800" id="kpi-overall">0%</h3>
            </div>
            <div class="glass-card !h-auto p-5 border-l-4 border-l-emerald-500">
                <p class="text-slate-500 font-semibold text-xs uppercase mb-1">Torre Mais Adiantada</p>
                <h3 class="text-xl font-bold text-slate-800 mt-1" id="kpi-best">-</h3>
